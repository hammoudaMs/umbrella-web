# Production / staging (required for real launch)
NEXT_PUBLIC_USE_MOCK=false
NEXT_PUBLIC_API_URL=https://api.your-domain.tn

# Role-based tenants (path today → subdomain later)
# path: localhost:3010/livreur · subdomain: livreur.localhost:3010 or livreur.umbrella.tn
NEXT_PUBLIC_TENANT_MODE=path
NEXT_PUBLIC_TENANT_ROOT_DOMAIN=localhost
# Production example:
# NEXT_PUBLIC_TENANT_MODE=subdomain
# NEXT_PUBLIC_TENANT_ROOT_DOMAIN=umbrella.tn

# Local demo only (browser fake API — never ship with these):
# NEXT_PUBLIC_USE_MOCK=true
# NEXT_PUBLIC_API_URL=http://localhost:3011
